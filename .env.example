# KiteConnect API
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_USER_ID=your_user_id_here
KITE_PASSWORD=your_password_here
KITE_TWO_FA=your_two_fa_here

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=stock-quotes
KAFKA_PARTITIONS=25

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# InfluxDB Configuration
INFLUXDB_HOST=localhost
INFLUXDB_PORT=8086
INFLUXDB_DATABASE=stock_data
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin_password
INFLUXDB_BUCKET=stocks
INFLUXDB_ORG=algotrade

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your_api_key_for_external_access

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Environment
ENVIRONMENT=development

# Model Configuration
MODEL_PATH=models/tft_v1.pth
MODEL_CACHE_TTL=2

# Stocks to Track
STOCKS=RELIANCE,INFY,TCS,WIPRO,LT,ASIANPAINT

# Market Hours (IST)
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
PRE_MARKET_OPEN=09:00
